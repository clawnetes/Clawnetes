# User identity
USER_NAME=TestUser
AGENT_NAME=TestAgent

# AI Provider: anthropic | openai | google | openrouter | xai | ollama | lmstudio | local
AI_PROVIDER=anthropic
AUTH_METHOD=token
API_KEY=sk-ant-api03-...
MODEL=claude-sonnet-4-20250514

# Messaging: telegram | whatsapp
MESSAGING_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# WhatsApp (if MESSAGING_CHANNEL=whatsapp)
# WHATSAPP_DM_POLICY=allowlist
# WHATSAPP_PHONE=+1234567890

# Remote deployment (set DEPLOY_TARGET=remote to enable)
DEPLOY_TARGET=local
# REMOTE_IP=192.168.1.100
# REMOTE_USER=ubuntu
# REMOTE_PASSWORD=
# REMOTE_SSH_KEY=~/.ssh/id_rsa
