{
  "name": "clawnetes",
  "version": "0.7.0",
  "description": "Native setup wizard for OpenClaw",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:remote": "playwright test --config playwright.real.config.ts -g 'Remote Deployment'",
    "test:e2e:build": "npm run tauri build && npm run test:e2e"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^16.4.7",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "vitest": "^4.0.18"
  }
}
